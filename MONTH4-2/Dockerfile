# Generated by make_container_files.py (Day 19).
FROM python:3.11-slim

# One place for every cache, so a named volume can keep them between restarts (the embedding model is a few GB).
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HF_HOME=/models/huggingface \
    XDG_CACHE_HOME=/models/cache \
    TIKTOKEN_CACHE_DIR=/models/tiktoken \
    NLTK_DATA=/models/nltk \
    LLAMA_INDEX_CACHE_DIR=/models/llama_index \
    RAG_HOST=0.0.0.0 \
    RAG_PORT=8000

# Never run as root inside the container.
RUN groupadd --system --gid 10001 app \
 && useradd --system --uid 10001 --gid app --home-dir /app --shell /usr/sbin/nologin app

WORKDIR /app

# PyTorch first, as the CPU build (no GPU in the container; saves about 2.5 GB). --no-deps: everything
# else it needs is pinned in requirements.docker.txt.
COPY requirements.torch.txt .
RUN pip install --no-deps --index-url https://download.pytorch.org/whl/cpu -r requirements.torch.txt

COPY requirements.docker.txt .
RUN pip install -r requirements.docker.txt

COPY --chown=app:app rag_pipeline ./rag_pipeline
COPY --chown=app:app serve.py api_layer.py docker_healthcheck.py monitoring.py alert_rules.py notifiers.py watchdog.py ./
COPY --chown=app:app  ./ ./
COPY --chown=app:app day14_visual_index.json ./day14_visual_index.json

# Folders the app writes to must exist and belong to the app user BEFORE a volume is mounted on them.
RUN mkdir -p /models /app/checkpoints && chown -R app:app /models /app/checkpoints

USER app
EXPOSE 8000

# Alive check only (/healthz). Whether the databases answer is /readyz, which a load balancer should use.
HEALTHCHECK --interval=30s --timeout=5s --start-period=300s --retries=3 CMD ["python", "docker_healthcheck.py"]

CMD ["python", "serve.py"]
